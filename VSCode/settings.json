{
  "[python]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "ms-python.black-formatter"
  },
  "editor.accessibilitySupport": "off",
  "editor.bracketPairColorization.enabled": false,
  "editor.defaultFormatter": "esbenp.prettier-vscode",
  "editor.fontFamily": "Menlo",
  "editor.fontSize": 14,
  "editor.fontWeight": 400,
  "editor.formatOnPaste": true,
  "editor.formatOnSave": true,
  "editor.inlineSuggest.enabled": true,
  "editor.tabSize": 2,
  "editor.tokenColorCustomizations": {
    "textMateRules": [
      {
        "scope": "comment",
        "settings": {
          "fontStyle": "italic"
        }
      }
    ]
  },
  "extensions.ignoreRecommendations": true,
  "files.associations": {
    "*.snap": "javascript",
    "*.svg": "html",
    ".env.development": "shellscript",
    ".env.development.local": "shellscript",
    ".env.local": "shellscript",
    ".flake8": "toml",
    "*.toml": "toml"
  },
  "files.exclude": {
    "**/.DS_Store": true,
    "**/.git": true,
    "**/.hg": true,
    "**/.svn": true,
    "**/CVS": true,
    "**/node_modules": true
  },
  "files.insertFinalNewline": true,
  "files.trimFinalNewlines": true,
  "files.trimTrailingWhitespace": true,
  "git.openRepositoryInParentFolders": "never",
  "github.copilot.enable": {
    "*": true,
    "plaintext": false,
    "markdown": false,
    "scminput": false,
    "typescriptreact": true,
    "yaml": true,
    "sql": false
  },
  "javascript.updateImportsOnFileMove.enabled": "always",
  "window.newWindowDimensions": "maximized",
  "workbench.settings.editor": "json",
  "workbench.startupEditor": "none",
  "terminal.integrated.env.osx": {
    "FIG_NEW_SESSION": "1"
  },
  "workbench.editor.revealIfOpen": false,
  "security.workspace.trust.untrustedFiles": "open",
  "typescript.updateImportsOnFileMove.enabled": "always",
  "editor.minimap.renderCharacters": false,
  "editor.renderControlCharacters": false,
  "[rust]": {
    "editor.defaultFormatter": "rust-lang.rust-analyzer",
    "editor.formatOnSave": true
  },
  "editor.wordWrap": "wordWrapColumn",
  "editor.wordWrapColumn": 96,
  "explorer.openEditors.visible": 3,
  "[sql]": {
    "editor.defaultFormatter": "inferrinizzard.prettier-sql-vscode"
  },
  "chat.editor.fontSize": 16,
  "python.languageServer": "Pylance",
  "[toml]": {
    "editor.defaultFormatter": "tamasfe.even-better-toml"
  },
  "dbcode.connections": [
    {
      "connectionId": "h5fv2G1k59Ql6HnD1DMry",
      "name": "navrate",
      "driver": "duckdb",
      "socket": "/Users/christiannaths/Projects/navrate/navrate/packages/data-pipeline/duckdb/navrate_data.duckdb",
      "readOnly": false,
      "connectionType": "socket"
    }
  ],
  "dbcode.resultLocation": "panel",
  "workbench.preferredLightColorTheme": "Cloud City",
  "window.systemColorTheme": "auto",
  "dbcode.ai.inlineCompletion": false,
  "dbcode.ai.mcp.authorization": "None",
  "workbench.editorAssociations": {
    "*.copilotmd": "vscode.markdown.preview.editor",
    "*.svg": "default"
  },
  "github.copilot.nextEditSuggestions.enabled": true,
  "workbench.secondarySideBar.defaultVisibility": "hidden",
  "window.zoomLevel": 0.75,
  "githubLocalActions.dockerDesktopPath": "/Applications/Docker.app",
  "turbo.path": "./node_modules/.bin/turbo",
  "workbench.iconTheme": "vscode-jetbrains-icon-theme-2023-light",
  "workbench.colorTheme": "Cloud City",
  "claudeCode.preferredLocation": "panel"
}
